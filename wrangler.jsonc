{
  // Assets-only Worker (no "main" / Worker script): serves the static SPA built into ./dist.
  // not_found_handling = "single-page-application" serves index.html (200 OK) for any path
  // that does not match a static asset, providing client-side routing fallback for BrowserRouter.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusensia-landingpage",
  "compatibility_date": "2026-09-25",
  // Custom Domain: Cloudflare provisions the apex DNS record + SSL cert and
  // serves the Worker as the origin for nusensia.com.
  "routes": [
    { "pattern": "nusensia.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
